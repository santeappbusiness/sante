# Client-safe
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. These must never appear in a NEXT_PUBLIC_ variable.
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=

# Set to "on" only after Google is configured in the Supabase dashboard.
# Leave unset and the app is demo-only, which is a working state, not a broken one.
NEXT_PUBLIC_GOOGLE_AUTH=
